# EmailJS credentials — get these from https://dashboard.emailjs.com
# 1. Create an Email Service (e.g. connect Gmail) -> copy its Service ID
# 2. Create an Email Template -> copy its Template ID
# 3. Account -> General -> copy your Public Key
#
# Copy this file to .env and fill in real values. .env is gitignored,
# so your keys won't be committed.
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
